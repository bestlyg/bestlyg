{
    "name": "@bestlyg/server-shared",
    "version": "0.0.0",
    "description": "",
    "license": "ISC",
    "author": "bestlyg",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "import": "./*",
            "default": "./*"
        }
    },
    "scripts": {
        "build": "rslib build",
        "dev": "rslib build --watch",
        "test": "rstest run",
        "test:watch": "rstest watch"
    },
    "dependencies": {
        "@bestlyg/core-shared": "workspace:^",
        "dayjs": "catalog:",
        "exceljs": "catalog:",
        "figlet": "catalog:",
        "fs-extra": "catalog:",
        "metadata-file": "workspace:^",
        "module-checker": "workspace:^",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/fs-extra": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    }
}
