{
    "name": "@bestlyg/client-shared",
    "version": "0.0.0",
    "description": "",
    "license": "ISC",
    "author": "bestlyg",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "import": "./*",
            "default": "./*"
        }
    },
    "scripts": {
        "build": "rslib build",
        "dev": "rslib build --watch"
    },
    "dependencies": {
        "@bestlyg/core-shared": "workspace:^",
        "axios": "catalog:",
        "tapable": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    }
}
