{
    "name": "@bestlyg/core-shared",
    "version": "0.0.0",
    "description": "",
    "license": "ISC",
    "author": "bestlyg",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "import": "./*",
            "default": "./*"
        }
    },
    "scripts": {
        "build:idl": "node scripts/idl.mjs",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "test": "rstest run",
        "test:watch": "rstest watch"
    },
    "dependencies": {
        "@noble/ciphers": "catalog:",
        "dayjs": "catalog:",
        "eventemitter3": "catalog:",
        "immer": "catalog:",
        "nanoid": "catalog:",
        "rxjs": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "@xidl/typescript-client": "workspace:^",
        "@xidl/typescript-server": "workspace:^",
        "express": "catalog:",
        "typedoc": "catalog:",
        "typedoc-plugin-markdown": "catalog:",
        "typescript": "catalog:compilerApi"
    }
}
