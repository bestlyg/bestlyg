{
    "name": "@bestlyg/cli",
    "version": "0.0.0",
    "keywords": [],
    "license": "ISC",
    "author": "bestlyg",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./globals": {
            "types": "./dist/globals.d.mts",
            "default": "./dist/globals.mjs"
        },
        "./*": {
            "import": "./*",
            "default": "./*"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rslib build",
        "dev": "rslib build --watch"
    },
    "dependencies": {
        "@bestlyg/core-shared": "workspace:^",
        "@bestlyg/server-shared": "workspace:^",
        "@manypkg/get-packages": "catalog:",
        "@types/doctrine": "catalog:",
        "@types/fs-extra": "catalog:",
        "@types/jsdom": "catalog:",
        "@types/lodash": "catalog:",
        "@types/minimist": "catalog:",
        "@types/node": "catalog:",
        "@types/semver": "catalog:",
        "@typescript/typescript6": "catalog:",
        "adm-zip": "catalog:",
        "axios": "catalog:",
        "cheerio": "catalog:",
        "commander": "catalog:",
        "cross-env": "catalog:",
        "dayjs": "catalog:",
        "doctrine": "catalog:",
        "dotenv": "catalog:",
        "figlet": "catalog:",
        "fs-extra": "catalog:",
        "inquirer": "catalog:",
        "jsdom": "catalog:",
        "lodash": "catalog:",
        "metadata-file": "workspace:^",
        "minimist": "catalog:",
        "ora": "catalog:",
        "semver": "catalog:",
        "winston": "catalog:",
        "zod": "catalog:",
        "zx": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "typescript": "catalog:"
    }
}
