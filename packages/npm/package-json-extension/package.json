{
    "name": "package-json-extension",
    "version": "0.0.5",
    "description": "Extend your package json.",
    "keywords": [
        "extend",
        "extends",
        "extension",
        "package",
        "package-json"
    ],
    "homepage": "https://github.com/bestlyg/package-json-extension",
    "license": "MIT",
    "author": "BestLyg",
    "repository": {
        "type": "git",
        "url": "git://github.com/bestlyg/package-json-extension.git"
    },
    "bin": {
        "extend-package-json": "./bin/extend-package-json.mjs"
    },
    "files": [
        "bin",
        "dist",
        "package.json",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "clean": "rimraf ./dist ./node_modules",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "test": "rstest run",
        "extend": "extend-package-json",
        "prepublishOnly": "pnpm build",
        "test:watch": "rstest watch"
    },
    "dependencies": {
        "chalk": "catalog:",
        "commander": "catalog:",
        "fs-extra": "catalog:",
        "lodash": "catalog:",
        "zx": "catalog:"
    },
    "devDependencies": {
        "@bestlyg/cli": "workspace:^",
        "@bestlyg/core-shared": "workspace:^",
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/node": "catalog:",
        "rimraf": "catalog:",
        "tslib": "catalog:",
        "typescript": "catalog:"
    }
}
