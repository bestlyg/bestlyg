{
    "name": "@less-plugins/css-logical",
    "version": "0.0.10",
    "description": "replace css properties to logical properties",
    "keywords": [
        "css",
        "less",
        "less css",
        "less functions",
        "less plugin",
        "less.js",
        "plugin",
        "properties",
        "replace"
    ],
    "homepage": "https://github.com/bestlyg/bestlyg/tree/master/packages/npm/less-plugins",
    "license": "MIT",
    "author": "BestLyg",
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf ./dist",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "prepublishOnly": "pnpm build",
        "test": "rstest run",
        "test:watch": "rstest watch"
    },
    "dependencies": {
        "@less-plugins/replace-properties": "workspace:^",
        "@less-plugins/shared": "workspace:^"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "less": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:"
    }
}
