{
    "name": "less-plugin-define-var",
    "version": "1.0.0",
    "description": "write custom Less variable in Plugin.",
    "keywords": [
        "css",
        "define-var",
        "less",
        "less css",
        "less functions",
        "less plugin",
        "less.js"
    ],
    "homepage": "https://github.com/bestlyg/less-plugins/packages/less-plugin-define-var",
    "license": "MIT",
    "author": "BestLyg",
    "repository": {
        "type": "git",
        "url": "git://github.com/bestlyg/less-plugins/packages/less-plugin-define-var.git"
    },
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf ./dist",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "prepublishOnly": "pnpm build",
        "render": "pnpm exec lessc",
        "extend-package-json": "extend-package-json",
        "test": "rstest run",
        "test:watch": "rstest watch"
    },
    "dependencies": {
        "less": "catalog:",
        "yargs": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/less": "catalog:",
        "@types/node": "catalog:",
        "@types/yargs": "catalog:",
        "package-json-extension": "workspace:^",
        "rimraf": "catalog:",
        "typescript": "catalog:"
    },
    "extension": {
        "extends": [
            "../../package.base.json"
        ],
        "vars": {
            "name": "define-var",
            "desc": "write custom Less variable in Plugin."
        }
    }
}
