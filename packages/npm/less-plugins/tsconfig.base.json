{
    "compilerOptions": {
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "allowJs": true,
        "noImplicitAny": false,
        "verbatimModuleSyntax": false,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "target": "ES2022",
        "types": ["node"],
        "moduleResolution": "Bundler"
    },
    "exclude": ["node_modules", "dist/**/*"]
}
