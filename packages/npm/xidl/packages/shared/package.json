{
    "name": "@xidl/shared",
    "version": "0.0.0",
    "keywords": [
        "idl"
    ],
    "homepage": "https://github.com/bestlyg/bestlyg/tree/master/packages/npm/xidl",
    "license": "MIT",
    "author": "bestlyg@foxmail.com",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "prepublishOnly": "pnpm build",
        "build": "rslib build",
        "dev": "rslib build --watch"
    },
    "dependencies": {
        "change-case": "catalog:",
        "fs-extra": "catalog:",
        "lodash-es": "catalog:",
        "protobufjs": "catalog:",
        "tapable": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@types/fs-extra": "catalog:",
        "@types/lodash-es": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    }
}
