{
    "name": "cscet",
    "version": "0.0.9",
    "description": "china software copyright extraction tool",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/bestlyg/bestlyg.git",
        "directory": "packages/npm/china-software-copyright-extraction-tool"
    },
    "bin": {
        "cscet": "./bin/china-software-copyright-extraction-tool.mjs"
    },
    "files": [
        "bin",
        "dist",
        "package.json",
        "README.md",
        "template.docx"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "run:publish": "pnpm publish --registry https://registry.npmjs.org --access=public --no-git-checks",
        "run:test": "pnpm test",
        "run:dev": "cross-env CSCET_DEV=1 node --max-old-space-size=4096 bin/china-software-copyright-extraction-tool.mjs",
        "run:prod": "node --max-old-space-size=4096 bin/china-software-copyright-extraction-tool.mjs",
        "prepublishOnly": "pnpm build",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "test": "rstest run",
        "test:watch": "rstest watch"
    },
    "dependencies": {
        "chalk": "catalog:",
        "commander": "catalog:",
        "docxtemplater": "catalog:",
        "pizzip": "catalog:",
        "ramda": "catalog:",
        "xml": "catalog:",
        "zx": "catalog:"
    },
    "devDependencies": {
        "@bestlyg/cli": "workspace:^",
        "@bestlyg/core-shared": "workspace:^",
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/node": "catalog:",
        "@types/ramda": "catalog:",
        "cross-env": "catalog:",
        "typescript": "catalog:"
    }
}
