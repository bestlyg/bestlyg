{
    "compilerOptions": {
        "rootDir": ".",
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "skipLibCheck": true,
        "lib": ["ESNext"],
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
