{
    "name": "generator-helpers",
    "version": "0.0.2",
    "keywords": [
        "generator"
    ],
    "homepage": "https://github.com/bestlyg/bestlyg/tree/master/packages/npm/xidl",
    "license": "MIT",
    "author": "bestlyg@foxmail.com",
    "files": [
        "package.json",
        "README.md",
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "prepublishOnly": "pnpm build",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "test": "rstest run",
        "test:watch": "rstest watch"
    },
    "devDependencies": {
        "@bestlyg/core-shared": "workspace:^",
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/lodash": "catalog:",
        "@types/node": "catalog:",
        "lodash": "catalog:",
        "typescript": "catalog:"
    }
}
