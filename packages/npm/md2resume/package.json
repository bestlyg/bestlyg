{
    "name": "md2resume",
    "version": "0.0.1",
    "author": "bestlyg",
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
