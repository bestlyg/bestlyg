{
    "name": "best-uploader",
    "version": "0.0.1",
    "keywords": [
        "uploader"
    ],
    "author": "bestlyg",
    "repository": {
        "type": "git",
        "url": "https://github.com/bestlyg/bestlyg.git",
        "directory": "packages/npm/uploader"
    },
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "prepublishOnly": "pnpm build",
        "build": "rslib build",
        "dev": "rslib build --watch",
        "test": "rstest run"
    },
    "dependencies": {
        "p-queue": "catalog:",
        "ramda": "catalog:",
        "tapable": "catalog:"
    },
    "devDependencies": {
        "@bestlyg/cli": "workspace:^",
        "@bestlyg/core-shared": "workspace:^",
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/node": "catalog:",
        "@types/ramda": "catalog:",
        "typescript": "catalog:"
    }
}
