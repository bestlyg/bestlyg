{
    "name": "@bestlyg/icons",
    "version": "0.0.0",
    "description": "Bestlyg React SVG icon set.",
    "license": "ISC",
    "author": "bestlyg",
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./svg-icon": {
            "types": "./dist/svg-icon.d.ts",
            "import": "./dist/svg-icon.mjs",
            "default": "./dist/svg-icon.mjs"
        },
        "./svg/*": {
            "types": "./dist/svg/*.d.ts",
            "import": "./dist/svg/*.mjs",
            "default": "./dist/svg/*.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dump": "node scripts/dump-svg.mjs -p ~/Downloads/库 && pnpm -w lint && node scripts/update-log.mjs",
        "lint": "tsc --noEmit",
        "lint:ci": "pnpm lint",
        "prepublishOnly": "pnpm build",
        "build": "rslib build",
        "dev": "rslib build --watch"
    },
    "dependencies": {
        "clsx": "catalog:",
        "react": "catalog:"
    },
    "devDependencies": {
        "@rslib/core": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "change-case": "catalog:",
        "consola": "catalog:",
        "dayjs": "catalog:",
        "typescript": "catalog:",
        "zx": "catalog:"
    }
}
