{
    "name": "@bestlyg/server",
    "version": "0.0.0",
    "private": true,
    "author": "bestlyg",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        "./*": {
            "import": "./*",
            "default": "./*"
        }
    },
    "scripts": {
        "build": "nest build",
        "format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
        "start": "cross-env NODE_ENV=development nest start",
        "start:dev": "cross-env NODE_ENV=development nest start --watch",
        "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
        "start:prod": "cross-env NODE_ENV=production node dist/main.mjs",
        "lint": "oxlint --fix .",
        "test": "rstest run",
        "test:watch": "rstest watch",
        "test:cov": "rstest run --coverage",
        "test:debug": "cross-env RSTEST_DEBUG=1 rstest run",
        "test:e2e": "rstest run --config rstest.dist.config.mts",
        "test:dist": "rstest run --config rstest.dist.config.mts",
        "create:problem": "tsx scripts/create-problem.ts",
        "create:ledger": "tsx scripts/create-ledger.ts",
        "create:xuan": "tsx scripts/create-xuan.ts"
    },
    "dependencies": {
        "@bestlyg/client": "workspace:^",
        "@bestlyg/core-shared": "workspace:^",
        "@bestlyg/server-shared": "workspace:^",
        "@bestlyg/static": "workspace:^",
        "@nestjs/common": "catalog:",
        "@nestjs/config": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/jwt": "catalog:",
        "@nestjs/platform-express": "catalog:",
        "@nestjs/schedule": "catalog:",
        "@nestjs/serve-static": "catalog:",
        "@nestjs/typeorm": "catalog:",
        "@typescript/typescript6": "catalog:",
        "axios": "catalog:",
        "c12": "catalog:",
        "chalk": "catalog:",
        "change-case": "catalog:",
        "compression": "catalog:",
        "cookie-parser": "catalog:",
        "dayjs": "catalog:",
        "dotenv": "catalog:",
        "exceljs": "catalog:",
        "express": "catalog:",
        "fs-extra": "catalog:",
        "lodash": "catalog:",
        "marked": "catalog:",
        "nest-winston": "catalog:",
        "nestjs-cls": "catalog:",
        "nodemailer": "catalog:",
        "pg": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "typeorm": "catalog:",
        "winston": "catalog:",
        "winston-daily-rotate-file": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@nestjs/cli": "catalog:",
        "@nestjs/schematics": "catalog:",
        "@nestjs/testing": "catalog:",
        "@rspack/core": "catalog:",
        "@rstest/core": "catalog:",
        "@rstest/coverage-v8": "catalog:",
        "@types/compression": "catalog:",
        "@types/cookie-parser": "catalog:",
        "@types/express": "catalog:",
        "@types/fs-extra": "catalog:",
        "@types/lodash": "catalog:",
        "@types/multer": "catalog:",
        "@types/node": "catalog:",
        "cross-env": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "supertest": "catalog:",
        "tsconfig-paths": "catalog:",
        "tsconfig-paths-webpack-plugin": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:compilerApi",
        "webpack-node-externals": "catalog:"
    }
}
