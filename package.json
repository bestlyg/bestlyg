{
    "name": "bestlyg",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "deploy": "node ./scripts/deploy.mjs",
        "build": "pnpm -r build",
        "typecheck": "node scripts/typecheck.mts",
        "submodule:update": "git submodule update --init --recursive",
        "version:node": "node -v",
        "setup": "rm -rf node_modules && rm -rf ./**/node_modules && pnpm i --force",
        "lint": "oxlint packages --config ./.oxlintrc.json",
        "e2e": "pnpm --filter @bestlyg/e2e e2e",
        "e2e:run": "pnpm --filter @bestlyg/e2e e2e:run",
        "e2e:list": "pnpm --filter @bestlyg/e2e e2e:list",
        "e2e:install": "pnpm --filter @bestlyg/e2e install:browsers",
        "format": "oxfmt \"**/*.{js,mjs,cjs,jsx,tsx,ts,mts,cts,md,json}\" --config ./.oxfmtrc.json",
        "format:affect": "node ./scripts/format-affect.mjs",
        "commit": "git-cz",
        "commit:auto": "git pull origin master && git add -A && pnpm run commit && git push --no-verify -u origin master && git push --no-verify -u github master",
        "script": "zx scripts/main.mjs",
        "<!-- 快捷方式 -->": "下面是快捷方式用的",
        "c": "pnpm run commit",
        "ca": "pnpm run commit:auto",
        "test": "rstest run",
        "test:watch": "rstest watch",
        "test:unit": "rstest run --project code --project server --project core-shared --project server-shared --project input-engine --project generator-helpers --project metadata-file --project package-json-extension --project '@less-plugins/*' --project cscet --project less-plugin-define-var --project uploader --project client-unit"
    },
    "devDependencies": {
        "@bestlyg/cli": "workspace:^",
        "@bestlyg/server-shared": "workspace:^",
        "@changesets/cli": "catalog:",
        "@changesets/get-release-plan": "catalog:",
        "@changesets/types": "catalog:",
        "@commitlint/cli": "catalog:",
        "@commitlint/config-conventional": "catalog:",
        "@manypkg/get-packages": "catalog:",
        "@rslib/core": "catalog:",
        "@rstest/core": "catalog:",
        "@types/node": "catalog:",
        "dotenv": "catalog:",
        "figlet": "catalog:",
        "git-cz": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "semver": "catalog:",
        "typescript": "catalog:",
        "zx": "catalog:"
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.14.0"
}
